      "name": "Sticky Note5"
    },
    {
      "parameters": {
        "content": "## 7. Tech Search\n\nFinds technicians listed in the system who can handle the issue category, who are available and have active tickets less than max capacity using a filtering logic (formula).",
        "height": 272,
        "width": 224,
        "color": "#0C4BE9"
      },
      "type": "n8n-nodes-base.stickyNote",
